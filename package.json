{
  "name": "wf-agent",
  "version": "0.1.0",
  "description": "A read-only local Kanban board for workflow-agent repositories",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "wf-agent": "bin/wf-agent.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p board/web && tsc -p board/server && vite build board/web --outDir ../../dist/web --emptyOutDir",
    "start": "node bin/wf-agent.js",
    "test": "npm run build && node scripts/board-test.mjs",
    "test:browser:install": "node scripts/board-test.mjs install",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "open": "^10.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
